---
import { SITE } from '../config/site';
const { yandexMetrikaId, googleAnalyticsId } = SITE.analytics;
---
<div class="cookie" role="dialog" aria-live="polite" aria-label="Уведомление о cookie" hidden data-cookie>
  <p>
    Сайт использует файлы cookie и сервисы веб-аналитики, чтобы работать удобнее.
    Нажимая «Принять», вы соглашаетесь на обработку данных в соответствии с
    <a href="/privacy/">политикой конфиденциальности</a>.
  </p>
  <div class="cookie__actions">
    <button type="button" class="btn" data-cookie-accept>Принять</button>
    <button type="button" class="cookie__decline" data-cookie-decline>Только необходимые</button>
  </div>
</div>

<script is:inline define:vars={{ ym: yandexMetrikaId, ga: googleAnalyticsId }}>
  (function () {
    var KEY = 'cookie-consent';
    var box = document.querySelector('[data-cookie]');
    function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }

    function loadAnalytics() {
      if (ym) {
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
          m[i].l = 1 * new Date();
          k = e.createElement(t); a = e.getElementsByTagName(t)[0]; k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
        window.ym(Number(ym), 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
      }
      if (ga) {
        var s = document.createElement('script');
        s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', ga, { anonymize_ip: true });
      }
    }

    var state = read();
    if (state === 'all') loadAnalytics();
    else if (!state && box) box.hidden = false;

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!(t instanceof Element)) return;
      if (t.closest('[data-cookie-accept]')) { save('all'); box.hidden = true; loadAnalytics(); }
      if (t.closest('[data-cookie-decline]')) { save('necessary'); box.hidden = true; }
      if (t.closest('[data-cookie-reset]')) { e.preventDefault(); try { localStorage.removeItem(KEY); } catch (err) {} box.hidden = false; }
    });
  })();
</script>

<style>
  .cookie {
    position: fixed; right: 24px; bottom: 24px; max-width: 420px; z-index: 90;
    background: #fff; border: 1px solid var(--line); box-shadow: 0 10px 40px rgba(0,0,0,.08);
    padding: 22px 24px; font-size: 13px; line-height: 1.6;
  }
  .cookie[hidden] { display: none; }
  .cookie p { margin: 0 0 16px; color: #444; }
  .cookie a { color: var(--accent); }
  .cookie__actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .cookie .btn { padding: .7rem 1.4rem; background: var(--text); color: #fff; cursor: pointer; font-family: inherit; }
  .cookie .btn:hover { background: #000; }
  .cookie__decline { background: none; border: 0; color: var(--muted); font: inherit; text-decoration: underline; cursor: pointer; padding: 0; }
  @media (max-width: 600px) { .cookie { left: 12px; right: 12px; bottom: 12px; max-width: none; } }
</style>
