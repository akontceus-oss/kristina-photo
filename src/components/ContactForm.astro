---
import { SITE } from '../config/site';
import { getMainServices } from '../lib/services';

interface Props {
  title?: string;
  /** Текст под заголовком; пустая строка — без текста */
  lead?: string;
  /** Подпись кнопки */
  button?: string;
  selected?: string;
}
const {
  title = 'Запись на съёмку',
  lead = 'Заполните форму — я свяжусь с вами в течение дня, уточню детали и рассчитаю стоимость.',
  button = 'Записаться',
  selected,
} = Astro.props;
const services = await getMainServices();
---
<section class="form-block" id="zayavka">
  {title && <h2>{title}</h2>}
  {lead && <p class="form-block__lead">{lead}</p>}
  <form class="form" method="post" action={SITE.form.endpoint} data-form novalidate>
    <div class="grid">
      <label class="f-name">
        <span>Имя *</span>
        <input name="name" type="text" autocomplete="name" required maxlength="100" />
      </label>
      <label class="f-service">
        <span>Вид съёмки *</span>
        <select name="service" required>
          {services.map((s) => <option value={s.data.title} selected={s.id === selected}>{s.data.title}</option>)}
          <option value="Другое">Другое</option>
        </select>
      </label>
      <label class="f-phone">
        <span>Телефон *</span>
        <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="18" placeholder="+7 (900) 123-45-67" pattern="\+7 \(\d{3}\) \d{3}-\d{2}-\d{2}" data-phone />
      </label>
      <label class="f-date">
        <span>Дата съёмки</span>
        <input name="date" type="date" data-date />
      </label>
      <label class="f-message">
        <span>Комментарии</span>
        <textarea name="message" rows="1" maxlength="2000" placeholder="Что снимаем, сколько позиций, даты" data-autosize></textarea>
      </label>
      <label class="f-email">
        <span>Эл. почта</span>
        <input name="email" type="email" autocomplete="email" maxlength="100" />
      </label>
    </div>
    <!-- Защита от спама: поле скрыто от людей, боты его заполняют -->
    <label class="hp" aria-hidden="true">Сайт<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    <input type="hidden" name="ts" value="" data-ts />
    <input type="hidden" name="page" value={Astro.url.pathname} />
    <label class="consent">
      <input type="checkbox" name="consent" value="1" required />
      <span>Я даю <a href="/soglasie/" target="_blank">согласие на обработку персональных данных</a> и ознакомлен(а) с <a href="/privacy/" target="_blank">политикой конфиденциальности</a></span>
    </label>
    <button type="submit" class="btn btn--dark">{button}</button>
    <p class="form__status" role="status" aria-live="polite" data-status></p>
  </form>
</section>

<style>
  .form-block { max-width: 900px; margin-top: 4rem; }
  .form-block h2 { font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: .5rem; }
  .form-block__lead { color: var(--text); margin-top: 0; }
  .form { display: grid; gap: 18px; margin-top: 1.5rem; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 40px; }
  .f-name { grid-column: 1; grid-row: 1; }
  .f-phone { grid-column: 1; grid-row: 2; }
  .f-email { grid-column: 1; grid-row: 3; }
  .f-service { grid-column: 2; grid-row: 1; }
  .f-date { grid-column: 2; grid-row: 2; }
  .f-message { grid-column: 2; grid-row: 3; display: flex; flex-direction: column; }
  .f-message textarea { flex: 1; min-height: 44px; }
  label span { display: block; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  input[type='text'], input[type='tel'], input[type='email'], input[type='date'], select, textarea {
    width: 100%; border: 0; border-bottom: 1px solid #cfcac4; padding: 10px 0; font: inherit; font-size: 15px;
    background: transparent; color: var(--text); border-radius: 0;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-bottom-color: var(--text); }
  .form.tried input:invalid { border-bottom-color: #a33; }
  textarea { resize: vertical; }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; color: var(--text); }
  .consent span { text-transform: none; letter-spacing: 0; font-size: 13px; color: var(--text); margin: 0; }
  .consent input { margin-top: 3px; accent-color: var(--text); }
  .consent a { color: var(--accent); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .btn--dark { background: var(--text); color: #fff; cursor: pointer; font-family: inherit; justify-self: start; }
  .btn--dark:hover { background: #000; }
  .btn--dark[disabled] { opacity: .5; cursor: wait; }
  .form__status { margin: 0; font-size: 14px; min-height: 1.5em; }
  .form__status.ok { color: #3c6e3c; }
  .form__status.err { color: #a33; }
  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; gap: 22px; }
    .grid > label { grid-column: 1 !important; grid-row: auto !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
    const ts = form.querySelector<HTMLInputElement>('[data-ts]')!;
    ts.value = String(Date.now());
    // Дата из календаря в разделе «Инфо»: /contacts/?date=ГГГГ-ММ-ДД
    const date = form.querySelector<HTMLInputElement>('[data-date]')!;
    date.min = new Date().toISOString().slice(0, 10);
    const preset = new URLSearchParams(location.search).get('date');
    if (preset && /^\d{4}-\d{2}-\d{2}$/.test(preset)) date.value = preset;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const say = (text: string, ok: boolean) => { status.textContent = text; status.className = 'form__status ' + (ok ? 'ok' : 'err'); };

    // Телефон: всегда +7 и маска +7 (900) 123-45-67, лишние цифры не вводятся
    const phone = form.querySelector<HTMLInputElement>('[data-phone]')!;
    const phoneDigits = (v: string) => {
      let d = v.replace(/\D/g, '');
      if (v.trimStart().startsWith('+7')) d = d.slice(1);
      if (d.length === 11 && /^[78]/.test(d)) d = d.slice(1); // вставили 8XXXXXXXXXX или 7XXXXXXXXXX
      return d.slice(0, 10);
    };
    const phoneFormat = (d: string) => {
      let s = '+7 ';
      if (d.length) s += '(' + d.slice(0, 3);
      if (d.length >= 3) s += ') ';
      if (d.length > 3) s += d.slice(3, 6);
      if (d.length > 6) s += '-' + d.slice(6, 8);
      if (d.length > 8) s += '-' + d.slice(8, 10);
      return s;
    };
    // Сколько цифр номера (без 7 из «+7») стоит до курсора
    const digitsBeforeCaret = () => phoneDigits(phone.value.slice(0, phone.selectionStart ?? phone.value.length)).length;
    const setPhone = (d: string, pos: number) => {
      phone.value = phoneFormat(d);
      let caret = 3;
      for (let seen = 0; caret < phone.value.length && seen < pos; caret++) if (/\d/.test(phone.value[caret])) seen++;
      if (pos >= d.length) caret = phone.value.length;
      phone.setSelectionRange(caret, caret);
    };
    phone.addEventListener('focus', () => { if (!phone.value) phone.value = '+7 '; });
    phone.addEventListener('blur', () => { if (phone.value.trim() === '+7') phone.value = ''; });
    phone.addEventListener('input', () => setPhone(phoneDigits(phone.value), digitsBeforeCaret()));
    // Backspace перед скобкой, пробелом или дефисом стирает цифру, а не знак маски
    phone.addEventListener('keydown', (e) => {
      const at = phone.selectionStart ?? 0;
      if (e.key !== 'Backspace' || at !== phone.selectionEnd || at <= 3 || /\d/.test(phone.value[at - 1])) return;
      e.preventDefault();
      const d = phoneDigits(phone.value), pos = digitsBeforeCaret();
      if (pos > 0) setPhone(d.slice(0, pos - 1) + d.slice(pos), pos - 1);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.classList.add('tried');
      if (!form.checkValidity()) {
        const consent = form.querySelector<HTMLInputElement>('[name=consent]')!;
        const name = form.querySelector<HTMLInputElement>('[name=name]')!;
        if (!name.value.trim()) say('Укажите, как к вам обращаться.', false);
        else if (!phone.validity.valid) say('Проверьте номер телефона: после +7 нужно 10 цифр.', false);
        else say(consent.checked ? 'Проверьте заполнение формы.' : 'Нужно согласие на обработку персональных данных.', false);
        return;
      }
      btn.disabled = true;
      say('Отправляю…', true);
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'error');
        form.reset();
        ts.value = String(Date.now());
        say('Спасибо! Заявка отправлена, я скоро свяжусь с вами.', true);
        (window as any).ym?.((window as any).__ymId, 'reachGoal', 'form_sent');
      } catch (err) {
        if ((err as Error).message === 'phone') say('Проверьте номер телефона: после +7 нужно 10 цифр.', false);
        else say('Не получилось отправить. Напишите мне в мессенджер — ссылки на странице «Контакты».', false);
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
