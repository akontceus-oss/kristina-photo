---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { photos: { src: ImageMetadata; alt: string }[] }
const { photos } = Astro.props;
// Большая версия для просмотра в лайтбоксе (webp, не больше 2000px)
const full = await Promise.all(photos.map((p) => getImage({ src: p.src, width: Math.min(2000, p.src.width), format: 'webp' })));
---
<div class="gallery" data-gallery>
  {photos.map((p, i) => (
    <a class="gallery__item" href={full[i].src} data-index={i} data-full={full[i].src}>
      <Image src={p.src} alt={p.alt} widths={[400, 700, 1000]} sizes="(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 33vw" loading={i < 3 ? 'eager' : 'lazy'} />
    </a>
  ))}
</div>

<dialog class="lightbox" data-lightbox aria-label="Просмотр фотографии">
  <button type="button" class="lb-close" aria-label="Закрыть" data-lb-close>×</button>
  <button type="button" class="lb-nav lb-prev" aria-label="Предыдущее фото" data-lb-prev>‹</button>
  <img alt="" data-lb-img />
  <button type="button" class="lb-nav lb-next" aria-label="Следующее фото" data-lb-next>›</button>
</dialog>

<style>
  .gallery { columns: 3 280px; column-gap: 20px; }
  .gallery__item { display: block; margin-bottom: 20px; break-inside: avoid; overflow: hidden; background: #f6f5f3; padding: 14px; }
  .gallery__item :global(img) { width: 100%; transition: transform .6s ease, opacity .3s; }
  .gallery__item:hover :global(img) { transform: scale(1.02); opacity: .95; }

  .lightbox { border: 0; padding: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; background: rgba(255,255,255,.97); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox::backdrop { background: rgba(255,255,255,.97); }
  .lightbox img { max-width: calc(100vw - 140px); max-height: calc(100vh - 60px); object-fit: contain; }
  .lb-close, .lb-nav { position: absolute; background: none; border: 0; font-size: 40px; color: #333; cursor: pointer; line-height: 1; padding: 10px 16px; }
  .lb-close { top: 10px; right: 14px; }
  .lb-prev { left: 10px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 10px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 600px) { .lightbox img { max-width: 100vw; } .lb-nav { font-size: 32px; } }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (gallery && box) {
    const items = [...gallery.querySelectorAll<HTMLAnchorElement>('.gallery__item')];
    const img = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
    let current = 0;
    const open = (i: number) => {
      current = (i + items.length) % items.length;
      const thumb = items[current].querySelector('img');
      img.src = items[current].dataset.full!;
      img.alt = thumb?.alt ?? '';
      if (!box.open) box.showModal();
    };
    items.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); open(i); }));
    box.querySelector('[data-lb-close]')!.addEventListener('click', () => box.close());
    box.querySelector('[data-lb-prev]')!.addEventListener('click', () => open(current - 1));
    box.querySelector('[data-lb-next]')!.addEventListener('click', () => open(current + 1));
    box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
    document.addEventListener('keydown', (e) => {
      if (!box.open) return;
      if (e.key === 'ArrowLeft') open(current - 1);
      if (e.key === 'ArrowRight') open(current + 1);
    });
  }
</script>
