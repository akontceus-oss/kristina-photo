---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slides: { src: ImageMetadata; alt: string }[];
  /** Интервал смены слайдов, мс. */
  interval?: number;
}
const { slides, interval = 5000 } = Astro.props;
---
<section class="slideshow" aria-roledescription="carousel" aria-label="Избранные фотографии" data-slideshow data-interval={interval}>
  {slides.map((s, i) => (
    <figure class:list={['slide', { active: i === 0 }]} aria-roledescription="slide" aria-label={`${i + 1} из ${slides.length}`} aria-hidden={i === 0 ? 'false' : 'true'}>
      <Picture
        src={s.src}
        alt={s.alt}
        formats={['avif', 'webp']}
        widths={[800, 1280, 1920, 2400]}
        sizes="(max-width: 900px) 100vw, calc(100vw - 300px)"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        decoding="async"
      />
    </figure>
  ))}
  <button type="button" class="nav-btn prev" aria-label="Предыдущее фото" data-prev>‹</button>
  <button type="button" class="nav-btn next" aria-label="Следующее фото" data-next>›</button>
  <slot />
</section>

<style>
  /* svh — «малая» высота экрана: не меняется, когда в мобильном Safari/Chrome
     при прокрутке прячется или появляется адресная строка. С dvh высота слайдера
     пересчитывалась на ходу, и весь контент под ним дёргался. */
  .slideshow { position: relative; height: 100vh; height: 100svh; overflow: hidden; background: #ddd; }
  .slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.4s ease; }
  .slide.active { opacity: 1; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .nav-btn {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
    width: 56px; height: 56px; border: 0; background: transparent; color: #fff;
    font-size: 44px; line-height: 1; cursor: pointer; opacity: 0; transition: opacity .3s;
    text-shadow: 0 1px 6px rgba(0,0,0,.35);
  }
  .slideshow:hover .nav-btn, .nav-btn:focus-visible { opacity: .85; }
  .prev { left: 12px; } .next { right: 12px; }
  @media (max-width: 900px) {
    .slideshow { height: calc(100vh - 64px); height: calc(100svh - 64px); }
    .nav-btn { opacity: .7; }
  }
  @media (prefers-reduced-motion: reduce) { .slide { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    if (slides.length < 2) return;
    const interval = Number(root.dataset.interval) || 5000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      slides[i].classList.remove('active');
      slides[i].setAttribute('aria-hidden', 'true');
      i = (n + slides.length) % slides.length;
      // Подгружаем следующий кадр заранее
      slides[(i + 1) % slides.length].querySelector('img')?.setAttribute('loading', 'eager');
      slides[i].classList.add('active');
      slides[i].setAttribute('aria-hidden', 'false');
    };
    const start = () => { if (!reduced) { stop(); timer = window.setInterval(() => show(i + 1), interval); } };
    const stop = () => window.clearInterval(timer);

    root.querySelector('[data-prev]')?.addEventListener('click', () => { show(i - 1); start(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { show(i + 1); start(); });

    // Свайпы на телефоне
    let x0: number | null = null;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) { show(dx < 0 ? i + 1 : i - 1); start(); }
      x0 = null;
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  });
</script>
