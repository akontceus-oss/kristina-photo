---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <p>© {year} {SITE.name}. {SITE.role} в Москве и Рязани.</p>
  <p class="footer__links">
    <a href="/privacy/">Политика конфиденциальности</a>
    <a href="/soglasie/">Согласие на обработку данных</a>
    <a href="#" data-cookie-reset>Настройки cookie</a>
  </p>
</footer>

<style>
  .footer { padding: 2rem 4rem 2.5rem; font-size: 12px; color: var(--muted); border-top: 1px solid var(--line); max-width: 1100px; }
  .footer p { margin: 0 0 .4rem; }
  .footer__links { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .footer a { color: var(--muted); }
  @media (max-width: 900px) { .footer { padding: 1.5rem 1.25rem 2rem; } }
</style>
