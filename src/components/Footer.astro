---
import { SITE } from '../config/site';
import { NAV } from '../config/nav';
import Socials from './Socials.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <nav aria-label="Меню в подвале">
    <ul class="footer__nav">
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
  <Socials class="footer__socials" />
  <p class="footer__links">
    <a href="/privacy/">Политика конфиденциальности</a>
    <a href="/soglasie/">Согласие на обработку данных</a>
    <a href="#" data-cookie-reset>Настройки cookie</a>
  </p>
  <p>© {year} {SITE.name}. {SITE.role} в Москве и Рязани.</p>
  {SITE.socials.instagram && <p>Instagram принадлежит компании Meta, признанной экстремистской организацией и запрещённой в РФ.</p>}
</footer>

<style>
  .footer { margin-top: 4rem; padding: 2.5rem 2rem 2.5rem; border-top: 1px solid var(--line); text-align: center; font-size: 12px; color: var(--muted); }
  .footer__nav { list-style: none; margin: 0 0 1.5rem; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 44px; }
  .footer__nav a { font: 500 12px/1.4 var(--font-sans); letter-spacing: .18em; text-transform: uppercase; color: #555; text-decoration: none; }
  .footer__nav a:hover { color: #000; }
  .footer :global(.footer__socials) { justify-content: center; margin-bottom: 1.25rem; }
  .footer p { margin: 0 0 .4rem; }
  .footer__links { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 1.2rem; }
  .footer a { color: var(--muted); }
  @media (max-width: 900px) { .footer { padding: 2rem 1.25rem; } .footer__nav { gap: 14px 28px; } }
</style>
