---
import { SITE } from '../config/site';
import { NAV } from '../config/nav';
import Socials from './Socials.astro';
import PageMap from './PageMap.astro'; // временно: карта страниц
const year = new Date().getFullYear();
---
<footer class="footer">
  <a class="footer__logo" href="/">{SITE.name}</a>
  <nav aria-label="Меню в подвале">
    <ul class="footer__nav">
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
  <Socials class="footer__socials" size={20} />
  <p class="footer__links">
    <a href="/blog/">Статьи</a>
    <a href="/privacy/">Политика конфиденциальности</a>
    <a href="/soglasie/">Согласие на обработку данных</a>
    <a href="#" data-cookie-reset>Настройки cookie</a>
  </p>
  <p>© {year} {SITE.name}. {SITE.role} в Москве и Рязани.</p>
  {SITE.socials.instagram && <p>Instagram принадлежит компании Meta, признанной экстремистской организацией и запрещённой в РФ.</p>}
  <PageMap /> {/* временно: убрать вместе с PageMap.astro */}
</footer>

<style>
  .footer { margin-top: 4rem; padding: 3.5rem 2rem 2.5rem; background: #0d0d0d; color: #bdbdbd; text-align: center; font-size: 12px; }
  .footer__logo { display: inline-block; margin-bottom: 1.5rem; font-family: var(--font-serif); font-size: 30px; letter-spacing: .14em; color: #fff; text-decoration: none; }
  .footer__nav { list-style: none; margin: 0 0 1.75rem; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 44px; }
  .footer__nav a { font: 500 12px/1.4 var(--font-sans); letter-spacing: .2em; text-transform: uppercase; color: #fff; text-decoration: none; }
  .footer__nav a:hover { color: #bdbdbd; }
  .footer :global(.footer__socials) { justify-content: center; margin-bottom: 1.75rem; }
  .footer :global(.footer__socials a) { color: #fff; }
  .footer :global(.footer__socials a:hover) { color: #bdbdbd; }
  .footer p { margin: 0 0 .4rem; }
  .footer__links { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 1.2rem; }
  .footer a { color: #d6d6d6; }
  .footer :global(.pagemap) { border-top-color: #333; }
  .footer :global(.pagemap code) { color: #8a8a8a; }
  @media (max-width: 900px) { .footer { padding: 2.5rem 1.25rem; } .footer__nav { gap: 14px 28px; } }
</style>
