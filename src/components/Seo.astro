---
import { SITE } from '../config/site';
import defaultOg from '../assets/slides/slide-1.jpg';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface SeoProps {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
  type?: 'website' | 'article' | 'profile';
  /** Дополнительная разметка schema.org (JSON-LD) для конкретной страницы. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = SITE.defaultDescription, image = defaultOg, noindex = false, type = 'website', schema } = Astro.props as SeoProps;
const fullTitle = title ?? SITE.defaultTitle;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, SITE.url).href;

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={`${SITE.name} — ${SITE.role.toLowerCase()}`} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

{SITE.verification.yandex && <meta name="yandex-verification" content={SITE.verification.yandex} />}
{SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}

{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
