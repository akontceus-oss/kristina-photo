---
import BaseLayout from '../layouts/BaseLayout.astro';
import Slideshow from '../components/Slideshow.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ContactForm from '../components/ContactForm.astro';
import Socials from '../components/Socials.astro';
import { SITE } from '../config/site';
import { getMainServices, formatPrice } from '../lib/services';
import { graph, personSchema, businessSchema, websiteSchema } from '../lib/schema';

// Все файлы из src/assets/slides попадают в слайдер по алфавиту.
// Чтобы поменять фото — просто замените/добавьте файлы в эту папку.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/slides/*.{jpg,jpeg,png,webp}', { eager: true });
const slides = Object.keys(files).sort().map((k, i) => ({
  src: files[k].default,
  alt: `Фотограф Кристина, Рязань и Москва — работа ${i + 1}`,
}));
const services = await getMainServices();
---
<BaseLayout schema={graph(websiteSchema(), businessSchema(), personSchema())}>
  <Slideshow slides={slides}>
    <div class="hero-caption">
      <p class="hero-caption__name">{SITE.role} {SITE.fullName}</p>
      <p>Рязань · Москва</p>
    </div>
    <a class="scroll-hint" href="#uslugi" aria-label="Листать вниз к услугам">↓</a>
  </Slideshow>

  <div class="page page--wide" id="uslugi">
    <h1>Фотограф в Рязани и Москве</h1>
    <p class="intro">
      Я — Кристина, фотограф из Рязани. Снимаю для ресторанов, кафе и бизнеса: меню и блюда, товары
      для маркетплейсов и сайтов, репортажи с открытий, банкетов и корпоративов. В Рязани работаю
      каждый день, в Москву приезжаю на съёмки — на вашу площадку или в студию.
    </p>
    <ServiceCards />

    <section class="city">
      <h2>Фотограф в Рязани</h2>
      <p>
        Рязань — мой город, поэтому выезд по городу всегда входит в стоимость, а дату съёмки можно
        подобрать быстро, даже к срочному открытию. Снимаю <a href="/semka-menyu-ryazan/">меню для ресторанов
        и кафе Рязани</a>, <a href="/predmetnaya-semka-ryazan/">предметную съёмку товаров</a>
        и <a href="/fotosemka-dlya-marketpleysov-ryazan/">фото для маркетплейсов</a>, а также
        <a href="/fotograf-na-meropriyatie-ryazan/">мероприятия</a>: открытия, банкеты, мастер-классы и праздники компаний.
        Весной снимаю <a href="/fotograf-na-vypusknoy-ryazan/">выпускные в школах</a>
        и <a href="/fotograf-na-vypusknoy-v-detskom-sadu-ryazan/">детских садах</a>.
      </p>
      <h2>Фотограф в Москве</h2>
      <p>
        В Москве я работаю в своей нише: фуд-съёмка, предметная съёмка и мероприятия ресторанов и небольших компаний.
        Смотрите <a href="/semka-menyu-moskva/">фуд-фотограф в Москве</a>,
        <a href="/predmetnaya-semka-moskva/">предметная съёмка в Москве</a> и
        <a href="/fotograf-na-meropriyatie-moskva/">фотограф на мероприятие в Москве</a>.
      </p>
    </section>

    <section class="prices">
      <h2>Стоимость</h2>
      <table>
        <tbody>
          {services.map((s) => (
            <tr><th scope="row"><a href={`/${s.id}/`}>{s.data.title}</a></th><td>{formatPrice(s.data.price)}{s.data.price ? ` / ${s.data.priceUnit}` : ''}</td></tr>
          ))}
        </tbody>
      </table>
      <p><a href="/uslugi/">Подробнее об услугах и условиях</a></p>
    </section>

    <ContactForm />

    <section class="messengers">
      <h2>Или напишите в мессенджер</h2>
      <Socials labels size={22} />
    </section>
  </div>
</BaseLayout>

<style>
  .hero-caption {
    position: absolute; left: 40px; bottom: 36px; z-index: 2; color: #fff;
    text-shadow: 0 1px 8px rgba(0,0,0,.35); pointer-events: none;
  }
  .hero-caption p { margin: 0; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; opacity: .85; }
  .hero-caption .hero-caption__name { font: 500 12px/1.4 var(--font-sans); letter-spacing: .22em; margin-bottom: 4px; opacity: 1; }
  .scroll-hint {
    position: absolute; right: 40px; bottom: 30px; z-index: 2; color: #fff; text-decoration: none; font-size: 22px;
    text-shadow: 0 1px 8px rgba(0,0,0,.35); animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob { 50% { transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .scroll-hint { animation: none; } }
  .page--wide { max-width: 1400px; }
  .intro { max-width: 760px; color: var(--text); margin-bottom: 3rem; }
  .city { max-width: 760px; margin-top: 4rem; }
  .city a { color: var(--accent); }
  .prices { margin: 4rem 0; max-width: 760px; }
  .prices table { width: 100%; border-collapse: collapse; }
  .prices th, .prices td { text-align: left; padding: 14px 0; border-bottom: 1px solid var(--line); font-weight: 400; }
  .prices td { text-align: right; white-space: nowrap; }
  .prices a { color: inherit; }
  .prices p a { color: var(--accent); }
  .messengers { margin-top: 3rem; }
  @media (max-width: 900px) { .hero-caption { left: 20px; bottom: 24px; } .scroll-hint { right: 20px; } }
</style>
