---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { graph, breadcrumbs } from '../lib/schema';
import { SITE } from '../config/site';
import { getMainServices, getAllServicePages, ancestorsOf, formatPrice } from '../lib/services';

// Цены и состав услуг берутся из файлов видов съёмок (src/content/services/*.md).
const services = await getMainServices();
// Все подвиды и посадочные под города, сгруппированные по основному виду съёмки
const allPages = await getAllServicePages();
const groups = services
  .map((s) => ({
    service: s,
    pages: allPages
      .filter((p) => ancestorsOf(p, allPages)[0]?.id === s.id)
      .sort((a, b) => Number(!!a.data.city) - Number(!!b.data.city) || a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'ru')),
  }))
  .filter((g) => g.pages.length);


const schema = graph(
  breadcrumbs([{ name: 'Цены', path: '/uslugi/' }]),
  {
    '@type': 'OfferCatalog',
    name: 'Услуги и стоимость фотосъёмки',
    url: `${SITE.url}/uslugi/`,
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      name: s.data.title,
      url: `${SITE.url}/${s.id}/`,
      priceCurrency: 'RUB',
      ...(s.data.price
        ? { priceSpecification: { '@type': 'UnitPriceSpecification', price: s.data.price, priceCurrency: 'RUB', unitText: s.data.priceUnit } }
        : {}),
      itemOffered: { '@type': 'Service', name: s.data.h1, provider: { '@id': `${SITE.url}/#business` } },
    })),
  },
);
---
<BaseLayout
  title="Услуги и цены: съёмка меню и предметная съёмка в Москве и Рязани — фотограф Кристина"
  description={`Услуги и стоимость фотосъёмки: ${services.map((s) => `${s.data.title.toLowerCase()} — ${formatPrice(s.data.price)}/${s.data.priceUnit}`).join(', ')}. Запись на съёмку онлайн. Москва и Рязань.`}
  schema={schema}
>
  <div class="page page--wide">
    <h1>Услуги и цены</h1>
    <p class="lead">Фотосъёмка в Москве и Рязани — на вашей площадке или в студии. Выезд в другие города и срочная обработка — по договорённости.</p>

    <div class="services">
      {services.map((s, i) => (
        <article class:list={['svc', { 'svc--rev': i % 2 }]}>
          <a class="svc__img" href={`/${s.id}/`} tabindex="-1" aria-hidden="true">
            <Image src={s.data.cover.src} alt="" widths={[600, 900]} sizes="(max-width: 900px) 100vw, 45vw" />
          </a>
          <div class="svc__body">
            <h2><a href={`/${s.id}/`}>{s.data.title}</a></h2>
            <p class="svc__price">{formatPrice(s.data.price)}{s.data.price ? <span> / {s.data.priceUnit}</span> : null}</p>
            <p class="svc__lead">{s.data.lead}</p>
            {s.data.includes.length > 0 && <ul>{s.data.includes.map((it) => <li>{it}</li>)}</ul>}
            {s.data.priceNote && <p class="svc__note">{s.data.priceNote}</p>}
            <p class="svc__actions">
              <a class="btn" href="#zayavka">Записаться</a>
              <a class="svc__more" href={`/${s.id}/`}>Портфолио и подробности</a>
            </p>
          </div>
        </article>
      ))}
    </div>

    {groups.length > 0 && (
      <section class="directions">
        <h2>Все направления</h2>
        <div class="directions__grid">
          {groups.map((g) => (
            <div>
              <h3><a href={`/${g.service.id}/`}>{g.service.data.title}</a></h3>
              <ul>{g.pages.map((p) => <li><a href={`/${p.id}/`}>{p.data.title}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="extra">
      <h2>Дополнительно</h2>
      <ul>
        <li>Аренда студии — оплачивается отдельно по тарифу студии</li>
        <li>Фуд-стилист, реквизит под задачу — по запросу</li>
        <li>Оплата: самозанятая, выдаю чек — удобно для юрлиц и ИП</li>
      </ul>
    </section>

    <p class="more">Свободные даты, отзывы и ответы на частые вопросы — в разделе <a href="/info/">«Инфо»</a>.</p>

    <ContactForm />
  </div>
</BaseLayout>

<style>
  .page--wide { max-width: 1300px; }
  .lead { color: var(--text); max-width: 680px; margin-bottom: 3.5rem; }
  .services { display: grid; gap: 5rem; }
  .svc { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .svc--rev .svc__img { order: 2; }
  .svc__img :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .svc h2 { margin: 0 0 .75rem; font-size: 2.2rem; }
  .svc h2 a { text-decoration: none; }
  .svc__price { font-size: 1.5rem; font-family: var(--font-serif); margin: 0 0 1rem; }
  .svc__price span { font-size: 1rem; color: var(--muted); }
  .svc__lead { color: var(--text); }
  .svc ul { padding-left: 1.1rem; color: var(--text); font-size: 16px; }
  .svc__note { color: var(--muted); font-size: 14px; }
  .svc__actions { display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; margin-top: 1.75rem; }
  .svc__more { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .directions { margin-top: 5rem; }
  .directions__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem 3rem; }
  .directions h3 { font-size: 1.4rem; margin: 0 0 .75rem; }
  .directions h3 a { text-decoration: none; }
  .directions ul { list-style: none; padding: 0; margin: 0; }
  .directions li { padding: .35rem 0; border-bottom: 1px solid var(--line); font-size: 16px; }
  .directions li a { color: var(--text); text-decoration: none; }
  .directions li a:hover { color: var(--text); }
  .extra { margin-top: 5rem; max-width: 760px; }
  .extra ul { color: var(--text); padding-left: 1.1rem; }
  .more { margin: 3rem 0 0; }
  .more a { color: var(--accent); }
  @media (max-width: 900px) {
    .services { gap: 3.5rem; }
    .svc { grid-template-columns: 1fr; gap: 1.5rem; }
    .svc--rev .svc__img { order: 0; }
    .svc h2 { font-size: 1.8rem; }
  }
</style>
