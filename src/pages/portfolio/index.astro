---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { graph, breadcrumbs } from '../../lib/schema';
import { getMainServices } from '../../lib/services';

// Все работы из всех видов съёмок одной лентой (без повторов)
const services = await getMainServices();
const seen = new Set<string>();
const photos = services.flatMap((s) => s.data.photos).filter((p) => !seen.has(p.src.src) && seen.add(p.src.src));
---
<BaseLayout
  title="Портфолио фотографа Кристины — съёмка меню и предметная съёмка"
  description="Портфолио фотографа Кристины: съёмка меню для ресторанов и кафе, предметная съёмка товаров. Москва и Рязань."
  schema={graph(breadcrumbs([{ name: 'Портфолио', path: '/portfolio/' }]))}
>
  <div class="page page--wide">
    <h1>Портфолио</h1>
    <nav class="chips" aria-label="Виды съёмок">
      {services.map((s) => <a href={`/${s.id}/`}>{s.data.title}</a>)}
    </nav>
    <Gallery photos={photos} />
  </div>
</BaseLayout>

<style>
  .page--wide { max-width: 1500px; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px 28px; margin: -0.5rem 0 2.5rem; }
  .chips a { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); text-decoration: none; border-bottom: 1px solid transparent; }
  .chips a:hover { color: var(--text); border-color: var(--text); }
</style>
