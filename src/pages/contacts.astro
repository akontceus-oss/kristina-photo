---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Socials from '../components/Socials.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../config/site';
import { graph, breadcrumbs, businessSchema } from '../lib/schema';
// Фото слева на странице контактов — заменить на любое своё
import photo from '../assets/about/kristina.jpg';

// Приветствие в рамке над контактами — поменяйте на свой текст
const GREETING = 'Я всегда открыта новым проектам и поездкам. Расскажите о своей задаче — подберу формат съёмки, рассчитаю стоимость и предложу удобную дату.';

const tel = SITE.contacts.phone.replace(/[^+\d]/g, '');
---
<BaseLayout
  title="Контакты фотографа Кристины — запись на съёмку в Москве и Рязани"
  description={`Связаться с фотографом Кристиной: ${SITE.contacts.phone}, WhatsApp, Telegram, ${SITE.contacts.email}. Запись на съёмку онлайн. Москва и Рязань.`}
  schema={graph(breadcrumbs([{ name: 'Контакты', path: '/contacts/' }]), { '@type': 'ContactPage', about: businessSchema() })}
>
  <div class="contacts">
    <div class="contacts__photo">
      <Image src={photo} alt={`${SITE.role} ${SITE.fullName}`} widths={[600, 1000, 1400]} sizes="(max-width: 1100px) 100vw, 40vw" />
    </div>
    <div class="contacts__text">
      <h1>Контакты</h1>
      <p class="greeting">{GREETING}</p>
      <p class="direct">
        <a href={`mailto:${SITE.contacts.email}`}>{SITE.contacts.email}</a>
        <span aria-hidden="true">|</span>
        <a href={`tel:${tel}`}>{SITE.contacts.phone}</a>
      </p>
      <Socials size={22} class="contacts__socials" />
      <ContactForm />
    </div>
  </div>
</BaseLayout>

<style>
  .contacts { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); min-height: 100vh; }
  .contacts__photo { position: relative; }
  .contacts__photo :global(img) { position: sticky; top: 0; width: 100%; height: 100vh; object-fit: cover; }
  .contacts__text { padding: 4.25rem 4rem 3rem; max-width: 760px; width: 100%; margin: 0 auto; text-align: center; }
  .greeting { border: 2px solid var(--text); padding: 1.25rem 1.75rem; margin: 0 auto 1.5rem; max-width: 560px; font-size: 16px; letter-spacing: .02em; line-height: 1.7; }
  .direct { margin: 0 0 1rem; font-size: 16px; letter-spacing: .04em; display: flex; justify-content: center; flex-wrap: wrap; gap: .25rem .9rem; }
  .direct a { text-decoration: none; }
  .contacts__text :global(.contacts__socials) { justify-content: center; }
  .contacts__text :global(.contacts__socials a) { color: var(--text); }
  .contacts__text :global(.form-block) { margin-top: 2.5rem; text-align: left; }
  @media (max-width: 1100px) {
    .contacts { grid-template-columns: 1fr; }
    .contacts__photo :global(img) { position: static; height: 50vh; }
    .contacts__text { padding: 2.5rem 1.25rem; }
  }
  @media (max-width: 600px) {
    .contacts__photo :global(img) { height: 34vh; }
    .contacts__text { padding: 1.75rem 1.25rem 2.5rem; }
    .contacts__text h1 { font-size: 2rem; margin-bottom: .75rem; }
    .greeting { border-width: 1px; padding: .85rem 1rem; font-size: 15px; line-height: 1.6; letter-spacing: .01em; margin-bottom: 1rem; }
    .direct { flex-direction: column; align-items: center; gap: .1rem; font-size: 16px; margin-bottom: .6rem; }
    .direct span { display: none; }
    .contacts__text :global(.form-block) { margin-top: 1.5rem; }
  }
</style>
