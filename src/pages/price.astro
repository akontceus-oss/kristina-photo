---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { graph, breadcrumbs } from '../lib/schema';
import { SITE } from '../config/site';
import { getMainServices, formatPrice } from '../lib/services';

// Цены берутся из файлов видов съёмок (src/content/services/*.md, поле price).
const services = await getMainServices();

const schema = graph(
  breadcrumbs([{ name: 'Прайс', path: '/price/' }]),
  {
    '@type': 'OfferCatalog',
    name: 'Стоимость фотосъёмки',
    url: `${SITE.url}/price/`,
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      name: s.data.title,
      url: `${SITE.url}/${s.id}/`,
      priceCurrency: 'RUB',
      ...(s.data.price
        ? { priceSpecification: { '@type': 'UnitPriceSpecification', price: s.data.price, priceCurrency: 'RUB', unitText: s.data.priceUnit } }
        : {}),
      itemOffered: { '@type': 'Service', name: s.data.h1, provider: { '@id': `${SITE.url}/#business` } },
    })),
  },
);
---
<BaseLayout
  title="Цены на съёмку меню и предметную съёмку в Москве и Рязани — фотограф Кристина"
  description={`Стоимость фотосъёмки: ${services.map((s) => `${s.data.title.toLowerCase()} — ${formatPrice(s.data.price)}/${s.data.priceUnit}`).join(', ')}. Москва и Рязань.`}
  schema={schema}
>
  <div class="page">
    <h1>Прайс</h1>
    <p class="lead">Стоимость фотосъёмки в Москве и Рязани. Минимальное время, выезд в другие города и срочная обработка — по договорённости.</p>
    <div class="packages">
      {services.map((s) => (
        <article class="pkg">
          <h2><a href={`/${s.id}/`}>{s.data.title}</a></h2>
          <p class="pkg__price">{formatPrice(s.data.price)}</p>
          {s.data.price && <p class="pkg__dur">за {s.data.priceUnit}</p>}
          {s.data.includes.length > 0 && <ul>{s.data.includes.map((it) => <li>{it}</li>)}</ul>}
          {s.data.priceNote && <p class="pkg__note">{s.data.priceNote}</p>}
        </article>
      ))}
    </div>
    <section class="prose extra">
      <h2>Дополнительно</h2>
      <ul>
        <li>Аренда студии — оплачивается отдельно по тарифу студии</li>
        <li>Фуд-стилист, реквизит под задачу — по запросу</li>
        <li>Оплата: самозанятая, выдаю чек — удобно для юрлиц и ИП</li>
      </ul>
    </section>
    <ContactForm />
  </div>
</BaseLayout>

<style>
  .lead { color: var(--muted); max-width: 640px; }
  .packages { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; margin-top: 2.5rem; }
  .pkg { border: 1px solid var(--line); padding: 2rem 1.75rem; }
  .pkg h2 { margin: 0 0 .75rem; font-size: 1.6rem; }
  .pkg h2 a { text-decoration: none; }
  .pkg__price { font-size: 1.4rem; margin: 0; }
  .pkg__dur { color: var(--muted); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; margin: .25rem 0 1rem; }
  .pkg ul { padding-left: 1.1rem; margin: 0; color: #444; font-size: 14px; }
  .pkg__note { color: var(--muted); font-size: 13px; }
  .extra { margin: 3rem 0; }
</style>
