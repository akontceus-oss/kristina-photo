---
import BaseLayout from '../layouts/BaseLayout.astro';
import { graph, breadcrumbs } from '../lib/schema';
import { SITE } from '../config/site';

// Цены и пакеты. Заменить на реальные — разметка schema.org обновится сама.
const packages = [
  { name: 'Мини-съёмка', price: 0, duration: '30 минут', items: ['15 фото в обработке', 'Одна локация', 'Готовность до 7 дней'] },
  { name: 'Стандарт', price: 0, duration: '1 час', items: ['35 фото в обработке', 'Помощь с образом и локацией', 'Готовность до 10 дней'] },
  { name: 'Расширенная', price: 0, duration: '2 часа', items: ['70 фото в обработке', '2 локации или смена образа', 'Готовность до 14 дней'] },
];
const fmt = (n: number) => (n ? `${n.toLocaleString('ru-RU')} ₽` : 'по запросу');

const schema = graph(
  breadcrumbs([{ name: 'Прайс', path: '/price/' }]),
  {
    '@type': 'OfferCatalog',
    name: 'Стоимость фотосессий',
    url: `${SITE.url}/price/`,
    itemListElement: packages.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      description: `${p.duration}: ${p.items.join(', ')}`,
      ...(p.price ? { price: p.price, priceCurrency: 'RUB' } : {}),
      itemOffered: { '@type': 'Service', name: `Фотосессия «${p.name}»`, provider: { '@id': `${SITE.url}/#business` } },
    })),
  },
);
---
<BaseLayout
  title="Цены на фотосессию в Москве и Рязани — прайс фотографа Кристины"
  description="Стоимость фотосессии у фотографа Кристины в Москве и Рязани: пакеты, длительность, количество фото и сроки готовности."
  schema={schema}
>
  <div class="page">
    <h1>Прайс</h1>
    <p class="lead">Стоимость фотосессий в Москве и Рязани. Выезд в другие города — по договорённости.</p>
    <div class="packages">
      {packages.map((p) => (
        <article class="pkg">
          <h2>{p.name}</h2>
          <p class="pkg__price">{fmt(p.price)}</p>
          <p class="pkg__dur">{p.duration}</p>
          <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
        </article>
      ))}
    </div>
    <section class="prose extra">
      <h2>Дополнительно</h2>
      <ul>
        <li>Аренда студии — оплачивается отдельно по тарифу студии</li>
        <li>Визажист и стилист — по запросу</li>
        <li>Дополнительные фото в обработке — [цена] ₽ за кадр</li>
      </ul>
      <p><a class="btn" href="/contacts/">Записаться</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .lead { color: var(--muted); max-width: 640px; }
  .packages { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-top: 2.5rem; }
  .pkg { border: 1px solid var(--line); padding: 2rem 1.75rem; }
  .pkg h2 { margin: 0 0 .75rem; font-size: 1.6rem; }
  .pkg__price { font-size: 1.25rem; margin: 0; }
  .pkg__dur { color: var(--muted); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; margin: .25rem 0 1rem; }
  .pkg ul { padding-left: 1.1rem; margin: 0; color: #444; }
  .extra { margin-top: 3rem; }
</style>
