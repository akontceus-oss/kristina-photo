---
/**
 * Посадочные страницы под ключевые запросы: /fotograf-moskva/, /semejnyj-fotograf-ryazan/ и т.д.
 * Чтобы добавить новую — создайте файл в src/content/landings/<адрес-страницы>.md
 */
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import { graph, breadcrumbs, faqSchema } from '../lib/schema';
import { SITE } from '../config/site';

export async function getStaticPaths() {
  const pages = await getCollection('landings', (e) => import.meta.env.DEV || !e.data.draft);
  return pages.map((entry) => ({ params: { landing: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const section = d.portfolio ? await getEntry('portfolio', d.portfolio) : undefined;
const path = `/${entry.id}/`;

const nodes: Record<string, unknown>[] = [
  breadcrumbs([{ name: d.h1, path }]),
  {
    '@type': 'Service',
    name: d.h1,
    serviceType: 'Фотосъёмка',
    areaServed: { '@type': 'City', name: d.city },
    provider: { '@id': `${SITE.url}/#business` },
    url: new URL(path, SITE.url).href,
    ...(d.priceFrom ? { offers: { '@type': 'Offer', price: d.priceFrom, priceCurrency: 'RUB' } } : {}),
  },
];
if (d.faq.length) nodes.push(faqSchema(d.faq));
---
<BaseLayout title={d.seoTitle} description={d.description} image={d.hero.src} schema={graph(...nodes)} noindex={d.draft}>
  <article class="landing">
    <header class="landing__hero">
      <Image src={d.hero.src} alt={d.hero.alt} widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, calc(100vw - 300px)" loading="eager" fetchpriority="high" />
      <div class="landing__title">
        <h1>{d.h1}</h1>
        <p>{d.lead}</p>
      </div>
    </header>
    <div class="page">
      <div class="prose body"><Content /></div>
      {d.priceFrom ? <p class="price">Стоимость — от {d.priceFrom.toLocaleString('ru-RU')} ₽. <a href="/price/">Все цены</a></p> : null}
      {section && (
        <section>
          <h2>Примеры работ</h2>
          <Gallery photos={section.data.photos} />
        </section>
      )}
      {d.faq.length > 0 && (
        <section class="faq">
          <h2>Частые вопросы</h2>
          {d.faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
        </section>
      )}
      <p class="cta"><a class="btn" href="/contacts/">Записаться на фотосессию</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .landing__hero { position: relative; height: 70vh; min-height: 420px; overflow: hidden; }
  .landing__hero :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .landing__title { position: absolute; left: 4rem; bottom: 3rem; right: 2rem; color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,.35); }
  .landing__title h1 { margin: 0 0 .5rem; }
  .landing__title p { margin: 0; max-width: 560px; }
  .body { max-width: 760px; }
  .price { font-size: 1.1rem; }
  .faq details { border-bottom: 1px solid var(--line); padding: 1rem 0; }
  .faq summary { cursor: pointer; font-family: var(--font-serif); font-size: 1.3rem; }
  .faq p { color: #444; }
  .cta { margin-top: 3rem; }
  @media (max-width: 900px) { .landing__title { left: 1.25rem; bottom: 1.5rem; } }
</style>
