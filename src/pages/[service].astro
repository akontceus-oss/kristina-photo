---
/**
 * Страница вида съёмки или посадочная под город: /semka-menyu/, /predmetnaya-semka-ryazan/ …
 * Новая страница = новый файл в src/content/services/<адрес>.md
 */
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import ContactForm from '../components/ContactForm.astro';
import { getAllServicePages, getMainServices, formatPrice } from '../lib/services';
import { graph, breadcrumbs, faqSchema } from '../lib/schema';
import { SITE } from '../config/site';

export async function getStaticPaths() {
  const pages = await getAllServicePages();
  return pages.map((entry) => ({ params: { service: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const parent = d.parent ? await getEntry('services', d.parent) : undefined;
const photos = d.photos.length ? d.photos : (parent?.data.photos ?? []);
const others = (await getMainServices()).filter((s) => s.id !== entry.id && s.id !== d.parent);
const path = `/${entry.id}/`;
const areas = d.city ? [d.city] : SITE.cities;

const crumbs = [
  ...(parent ? [{ name: parent.data.title, path: `/${parent.id}/` }] : [{ name: 'Портфолио', path: '/portfolio/' }]),
  { name: d.title, path },
];
const nodes: Record<string, unknown>[] = [
  breadcrumbs(crumbs),
  {
    '@type': 'Service',
    name: d.h1,
    description: d.description,
    serviceType: parent?.data.title ?? d.title,
    areaServed: areas.map((name) => ({ '@type': 'City', name })),
    provider: { '@id': `${SITE.url}/#business` },
    url: new URL(path, SITE.url).href,
    ...(d.price
      ? {
          offers: {
            '@type': 'Offer',
            priceCurrency: 'RUB',
            priceSpecification: { '@type': 'UnitPriceSpecification', price: d.price, priceCurrency: 'RUB', unitText: d.priceUnit },
          },
        }
      : {}),
  },
];
if (d.faq.length) nodes.push(faqSchema(d.faq));
---
<BaseLayout title={d.seoTitle} description={d.description} image={d.cover.src} schema={graph(...nodes)} noindex={d.draft}>
  <article>
    <header class="hero">
      <Image src={d.cover.src} alt={d.cover.alt} widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, calc(100vw - 300px)" loading="eager" fetchpriority="high" />
      <div class="hero__text">
        <nav class="crumbs" aria-label="Хлебные крошки">
          <a href="/">Главная</a> / {crumbs.slice(0, -1).map((c) => <><a href={c.path}>{c.name}</a> / </>)}<span>{d.title}</span>
        </nav>
        <h1>{d.h1}</h1>
        <p>{d.lead}</p>
        <p class="hero__price">{formatPrice(d.price)}{d.price ? ` / ${d.priceUnit}` : ''}</p>
        <a class="btn btn--light" href="#zayavka">Оставить заявку</a>
      </div>
    </header>

    <div class="page page--wide">
      <div class="intro">
        <div class="prose"><Content /></div>
        {d.includes.length > 0 && (
          <aside class="includes">
            <h2>Что входит</h2>
            <ul>{d.includes.map((i) => <li>{i}</li>)}</ul>
            {d.priceNote && <p class="note">{d.priceNote}</p>}
          </aside>
        )}
      </div>

      {photos.length > 0 && (
        <section>
          <h2>Портфолио</h2>
          <Gallery photos={photos} />
        </section>
      )}

      {d.faq.length > 0 && (
        <section class="faq">
          <h2>Частые вопросы</h2>
          {d.faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
        </section>
      )}

      <ContactForm selected={parent?.id ?? entry.id} />

      {others.length > 0 && (
        <section class="others">
          <h2>Другие виды съёмок</h2>
          <ul>{others.map((s) => <li><a href={`/${s.id}/`}>{s.data.title}</a> — {formatPrice(s.data.price)}{s.data.price ? ` / ${s.data.priceUnit}` : ''}</li>)}</ul>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .hero { position: relative; height: 78vh; min-height: 460px; overflow: hidden; }
  .hero :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,0) 60%); }
  .hero__text { position: absolute; left: 4rem; right: 2rem; bottom: 3rem; color: #fff; z-index: 1; max-width: 680px; }
  .hero__text h1 { margin: .5rem 0 .75rem; }
  .hero__text p { margin: 0; }
  .hero__price { margin: 1rem 0 1.5rem !important; letter-spacing: .14em; text-transform: uppercase; font-size: 13px; }
  .crumbs { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; opacity: .85; }
  .crumbs a { color: #fff; text-decoration: none; }
  .btn--light { border-color: #fff; color: #fff; }
  .btn--light:hover { background: #fff; color: var(--text); }
  .page--wide { max-width: 1400px; }
  .intro { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 4rem; margin-bottom: 3rem; }
  .includes { border: 1px solid var(--line); padding: 1.75rem; align-self: start; }
  .includes h2 { margin-top: 0; font-size: 1.5rem; }
  .includes ul { padding-left: 1.1rem; margin: 0; color: #444; }
  .note { color: var(--muted); font-size: 13px; }
  .faq { max-width: 820px; margin: 3rem 0; }
  .faq details { border-bottom: 1px solid var(--line); padding: 1rem 0; }
  .faq summary { cursor: pointer; font-family: var(--font-serif); font-size: 1.3rem; }
  .faq p { color: #444; }
  .others { margin-top: 3rem; }
  .others ul { padding-left: 1.1rem; }
  .others a { color: var(--accent); }
  @media (max-width: 1000px) { .intro { grid-template-columns: 1fr; gap: 2rem; } }
  @media (max-width: 900px) { .hero__text { left: 1.25rem; bottom: 1.75rem; } }
</style>
