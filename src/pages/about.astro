---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/about/kristina.jpg';
import { graph, breadcrumbs, personSchema } from '../lib/schema';
import { SITE } from '../config/site';
---
<BaseLayout
  title="Об авторе — фотограф Кристина, Москва и Рязань"
  description="Знакомство с фотографом Кристиной: съёмка меню и предметная съёмка в Москве и Рязани, подход к работе."
  type="profile"
  image={portrait}
  schema={graph(breadcrumbs([{ name: 'Об авторе', path: '/about/' }]), { '@type': 'ProfilePage', mainEntity: personSchema() })}
>
  <div class="about">
    <div class="about__photo">
      <Image src={portrait} alt={`${SITE.role} ${SITE.fullName}`} widths={[500, 800]} sizes="(max-width: 1100px) 100vw, 40vw" loading="eager" />
    </div>
    <div class="about__text prose">
      <h1>Об авторе</h1>
      <p>Привет! Меня зовут Кристина, я фотограф из Москвы и Рязани. Снимаю меню для ресторанов и кафе и предметные фото для бизнеса.</p>
      <p>[Здесь будет знакомство: как пришла в фотографию, опыт в фуд- и предметной съёмке, с кем работала, как проходит съёмка, почему со мной удобно работать.]</p>
      <p>[2–3 абзаца живого текста. В нём естественно упомянуть города и виды съёмок — это помогает странице в поиске.]</p>
      <p><a class="btn" href="/contacts/">Связаться со мной</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  /* Тот же каркас, что на «Контактах»: фото заполняет колонку от края до края */
  .about { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); min-height: 100vh; }
  .about__photo { position: relative; }
  .about__photo :global(img) { position: sticky; top: 0; width: 100%; height: 100vh; object-fit: cover; }
  .about__text { padding: 4.25rem 4rem 3rem; max-width: 760px; width: 100%; }
  @media (max-width: 1100px) {
    .about { grid-template-columns: 1fr; min-height: 0; }
    .about__photo :global(img) { position: static; height: 50vh; }
    .about__text { padding: 2.5rem 1.25rem; }
  }
  @media (max-width: 600px) {
    .about__photo :global(img) { height: 34vh; }
    .about__text { padding: 1.75rem 1.25rem 2.5rem; }
  }
</style>
