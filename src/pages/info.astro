---
import BaseLayout from '../layouts/BaseLayout.astro';
import { graph, breadcrumbs, faqSchema } from '../lib/schema';

const faq = [
  { q: 'Как забронировать съёмку?', a: 'Оставьте заявку на сайте или напишите в мессенджер. Обсудим задачу, объём и дату. Бронь фиксируется предоплатой.' },
  { q: 'Как рассчитывается стоимость?', a: 'Оплата почасовая — цены указаны в прайсе. По списку блюд или товаров заранее оценю, сколько времени займёт съёмка.' },
  { q: 'Что подготовить к съёмке меню?', a: 'Список блюд, свежие ингредиенты и повара на время съёмки. Перед съёмкой пришлю подробную памятку.' },
  { q: 'Сколько ждать готовые фото?', a: 'Обычно 5–7 рабочих дней. Фото передаю по ссылке в нужных форматах и размерах.' },
  { q: 'Работаете с юрлицами?', a: 'Да. Я самозанятая: работаю по договору, выдаю чек — его можно учесть в расходах компании или ИП.' },
  { q: 'Вы снимаете в других городах?', a: 'Основные города — Москва и Рязань. Выезд в другие города возможен, стоимость обсуждается отдельно.' },
];
---
<BaseLayout
  title="Как проходит съёмка — условия и ответы на вопросы | фотограф Кристина"
  description="Как забронировать съёмку меню или предметную съёмку, оплата, сроки готовности фото, работа с юрлицами. Фотограф Кристина, Москва и Рязань."
  schema={graph(breadcrumbs([{ name: 'Инфо', path: '/info/' }]), faqSchema(faq))}
>
  <div class="page page--narrow">
    <h1>Инфо</h1>
    <div class="faq">
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .faq details { border-bottom: 1px solid var(--line); padding: 1.1rem 0; }
  .faq summary { cursor: pointer; font-family: var(--font-serif); font-size: 1.35rem; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--font-sans); color: var(--muted); transition: transform .2s; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq p { color: #444; margin: .75rem 0 0; }
</style>
