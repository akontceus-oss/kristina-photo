---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { graph, breadcrumbs } from '../lib/schema';
import { CALENDAR } from '../config/calendar';
---
<BaseLayout
  title="Календарь свободных дат для съёмки — фотограф Кристина"
  description="Свободные даты для съёмки меню, предметной и репортажной съёмки в Москве и Рязани. Выберите день и оставьте заявку."
  schema={graph(breadcrumbs([{ name: 'Календарь', path: '/info/' }]))}
>
  <div class="page">
    {/* Видимых заголовков и пояснений нет, по просьбе заказчика: только сам календарь.
        Заголовок оставлен для поисковиков и экранных дикторов. */}
    <h1 class="visually-hidden">Календарь свободных дат для съёмки</h1>

    <section class="cal" aria-label="Календарь съёмок">
      <div class="cal__months" data-calendar data-busy={JSON.stringify(CALENDAR.busy)} data-months={CALENDAR.months}></div>
      <p class="cal__legend"><span class="dot dot--free"></span>свободно <span class="dot dot--busy"></span>занято</p>
      <noscript><p>Чтобы узнать свободные даты, напишите мне — ссылки на странице <a href="/contacts/">«Контакты»</a>.</p></noscript>
    </section>

    <ContactForm />
  </div>
</BaseLayout>

<style>
  .cal__months { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 340px)); gap: 2.5rem; }
  .cal__months :global(.m h3) { font-family: var(--font-sans); font-size: 13px; font-weight: 400; letter-spacing: .16em; text-transform: uppercase; margin: 0 0 .9rem; }
  .cal__months :global(.grid7) { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; text-align: center; }
  .cal__months :global(.wd) { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; padding-bottom: 4px; }
  .cal__months :global(.d) { display: flex; align-items: center; justify-content: center; aspect-ratio: 1; font-size: 14px; text-decoration: none; border: 1px solid transparent; }
  .cal__months :global(a.d) { border-color: var(--line); color: var(--text); transition: background .2s, color .2s; }
  .cal__months :global(a.d:hover) { background: var(--text); color: #fff; }
  .cal__months :global(.d--busy) { background: #eceae6; text-decoration: line-through; color: #9a958f; }
  .cal__months :global(.d--past) { color: #c9c5c0; }
  .cal__legend { display: flex; align-items: center; gap: 8px; font-size: 14px; margin-top: 1.25rem; }
  .dot { display: inline-block; width: 12px; height: 12px; border: 1px solid var(--line); }
  .dot--busy { background: #eceae6; margin-left: 14px; }
</style>

<script>
  // Календарь строится в браузере, чтобы всегда показывать текущий месяц без пересборки сайта.
  const root = document.querySelector<HTMLElement>('[data-calendar]');
  if (root) {
    const busy = new Set<string>(JSON.parse(root.dataset.busy || '[]'));
    const months = Number(root.dataset.months || 2);
    const pad = (n: number) => String(n).padStart(2, '0');
    const iso = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const today = iso(new Date());
    const now = new Date();
    const html: string[] = [];
    for (let i = 0; i < months; i++) {
      const first = new Date(now.getFullYear(), now.getMonth() + i, 1);
      const days = new Date(first.getFullYear(), first.getMonth() + 1, 0).getDate();
      const title = first.toLocaleDateString('ru-RU', { month: 'long', year: 'numeric' }).replace(' г.', '');
      const cells = ['пн', 'вт', 'ср', 'чт', 'пт', 'сб', 'вс'].map((w) => `<span class="wd">${w}</span>`);
      for (let k = 0; k < (first.getDay() + 6) % 7; k++) cells.push('<span></span>');
      for (let day = 1; day <= days; day++) {
        const key = iso(new Date(first.getFullYear(), first.getMonth(), day));
        if (key < today) cells.push(`<span class="d d--past">${day}</span>`);
        else if (busy.has(key)) cells.push(`<span class="d d--busy" title="Занято">${day}</span>`);
        else cells.push(`<a class="d" href="/contacts/?date=${key}#zayavka" title="Записаться на ${day} число">${day}</a>`);
      }
      html.push(`<div class="m"><h3>${title}</h3><div class="grid7">${cells.join('')}</div></div>`);
    }
    root.innerHTML = html.join('');
  }
</script>
